//Circular queue
#include <stdio.h>

#define MAX 5

struct Job
{
    int id;
    char title[50];
};

struct Job queue[MAX];

int front = -1;
int rear = -1;

/* Check if queue is empty */
int isEmpty()
{
    return front == -1;
}

/* Check if queue is full */
int isFull()
{
    return (rear + 1) % MAX == front;
}

/* Enqueue */
void enqueue()
{
    struct Job j;

    if (isFull())
    {
        printf("Queue Overflow! Print queue is full.\n");
        return;
    }

    printf("Enter Job ID: ");
    scanf("%d", &j.id);

    printf("Enter Document Title: ");
    scanf("%s", j.title);

    if (isEmpty())
    {
        front = 0;
        rear = 0;
    }
    else
    {
        rear = (rear + 1) % MAX;
    }

    queue[rear] = j;

    printf("Print job added successfully.\n");
}

/* Dequeue */
void dequeue()
{
    if (isEmpty())
    {
        printf("Queue Underflow! No print jobs available.\n");
        return;
    }

    printf("Processed Job ID: %d\n", queue[front].id);
    printf("Document Title: %s\n", queue[front].title);

    if (front == rear)
    {
        front = -1;
        rear = -1;
    }
    else
    {
        front = (front + 1) % MAX;
    }
}

/* Display */
void display()
{
    int i;

    if (isEmpty())
    {
        printf("No Pending Print Jobs.\n");
        return;
    }

    printf("\nPending Print Jobs:\n");

    i = front;

    while (1)
    {
        printf("Job ID: %d, Title: %s\n",
               queue[i].id,
               queue[i].title);

        if (i == rear)
            break;

        i = (i + 1) % MAX;
    }
}

/* Main */
int main()
{
    int choice;

    while (1)
    {
        printf("\n===== CIRCULAR PRINTER QUEUE =====\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                enqueue();
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Program ended.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
