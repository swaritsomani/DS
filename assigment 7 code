#include <stdio.h>
#include <ctype.h>

#define MAX 100

int stack[MAX];
int top = -1;

/* Push */
void push(int x)
{
    stack[++top] = x;
}

/* Pop */
int pop()
{
    return stack[top--];
}

int main()
{
    char exp[MAX];
    int i;
    int a, b, result;

    printf("Enter postfix expression: ");
    scanf("%s", exp);

    for (i = 0; exp[i] != '\0'; i++)
    {
        /* If operand */
        if (isdigit(exp[i]))
        {
            push(exp[i] - '0');
        }

        /* If operator */
        else
        {
            b = pop();
            a = pop();

            switch (exp[i])
            {
                case '+':
                    result = a + b;
                    break;

                case '-':
                    result = a - b;
                    break;

                case '*':
                    result = a * b;
                    break;

                case '/':
                    result = a / b;
                    break;

                default:
                    printf("Invalid operator\n");
                    return 1;
            }

            push(result);
        }
    }

    printf("Result = %d\n", pop());

    return 0;
}
